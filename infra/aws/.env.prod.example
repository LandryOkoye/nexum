# Copy to .env.prod and fill in. Gitignored - it holds live credentials.
#
#   cp infra/aws/.env.prod.example infra/aws/.env.prod

# The hostname judges will open. Its A record must already point at the Elastic
# IP before release.sh runs, or Caddy cannot complete the ACME challenge.
NEXUM_PUBLIC_HOST=nexum.example.duckdns.org

# ---- CockroachDB Cloud -------------------------------------------------
# From the cluster's Connect dialog, "General connection string", converted to
# JDBC form. Must be a v25.4+ cluster: vector_cosine_ops does not exist below
# that and migration V4 will fail on startup.
#
#   jdbc:postgresql://<host>:26257/<db>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&options=-c%20allow_unsafe_internals%3Dtrue
# sslfactory=DefaultJavaSSLFactory is required, not optional. With plain
# sslmode=verify-full the pgjdbc driver uses LibPQFactory, which looks for a CA
# at ~/.postgresql/root.crt and dies with FileNotFoundException in a container
# that has no such file. CockroachDB Cloud presents a publicly-trusted
# certificate, so delegating to the JVM truststore verifies it properly - this
# keeps full verification rather than weakening sslmode to get past the error.
# options=-c allow_unsafe_internals=true is a Flyway requirement, not ours.
# CockroachDB Cloud v26.2 restricts crdb_internal and system, and Flyway 12.4's
# CockroachDBDatabase.rawDetermineVersion reads crdb_internal to discover the
# server version - so every migration run fails before the first statement.
# Cockroach labels the setting "not recommended", and it is scoped to this
# session only. Nexum itself never reads crdb_internal; the alternative is
# running migrations by hand, which is worse.
NEXUM_DB_URL=jdbc:postgresql://CHANGEME.cockroachlabs.cloud:26257/nexum?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&options=-c%20allow_unsafe_internals%3Dtrue
NEXUM_DB_USERNAME=CHANGEME
NEXUM_DB_PASSWORD=CHANGEME

# ---- Reasoning ---------------------------------------------------------
GROQ_API_KEY=CHANGEME
NEXUM_GROQ_MODEL=openai/gpt-oss-120b

# ---- Live web research -------------------------------------------------
# Without this agents fall back to the offline corpus and say so at startup.
TAVILY_API_KEY=CHANGEME

# ---- AWS ---------------------------------------------------------------
# Region only. AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are deliberately
# absent: the instance role supplies credentials, and setting these - even to
# empty strings - shadows the role and breaks Bedrock on the deployed box while
# working perfectly on a laptop.
AWS_REGION=us-east-1
NEXUM_S3_BUCKET=
