# Copy to .env.prod and fill in. Gitignored - it holds live credentials.
#
#   cp infra/aws/.env.prod.example infra/aws/.env.prod

# The hostname judges will open. Its A record must already point at the Elastic
# IP before release.sh runs, or Caddy cannot complete the ACME challenge.
NEXUM_PUBLIC_HOST=nexum.example.duckdns.org

# ---- CockroachDB Cloud -------------------------------------------------
# From the cluster's Connect dialog, "General connection string", converted to
# JDBC form. Must be a v25.4+ cluster: vector_cosine_ops does not exist below
# that and migration V4 will fail on startup.
#
#   jdbc:postgresql://<host>:26257/<db>?sslmode=verify-full
NEXUM_DB_URL=jdbc:postgresql://CHANGEME.cockroachlabs.cloud:26257/nexum?sslmode=verify-full
NEXUM_DB_USERNAME=CHANGEME
NEXUM_DB_PASSWORD=CHANGEME

# ---- Reasoning ---------------------------------------------------------
GROQ_API_KEY=CHANGEME
NEXUM_GROQ_MODEL=openai/gpt-oss-120b

# ---- Live web research -------------------------------------------------
# Without this agents fall back to the offline corpus and say so at startup.
TAVILY_API_KEY=CHANGEME

# ---- AWS ---------------------------------------------------------------
# Region only. AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are deliberately
# absent: the instance role supplies credentials, and setting these - even to
# empty strings - shadows the role and breaks Bedrock on the deployed box while
# working perfectly on a laptop.
AWS_REGION=us-east-1
NEXUM_S3_BUCKET=
