# ---- CockroachDB -------------------------------------------------------
# Local dev uses compose.yaml (insecure single node); override for Cloud.
NEXUM_DB_URL=jdbc:postgresql://localhost:26257/nexum?sslmode=disable
NEXUM_DB_USERNAME=root
NEXUM_DB_PASSWORD=

# ---- Groq (reasoning) --------------------------------------------------
GROQ_API_KEY=

# ---- AWS (Bedrock embeddings + S3 artifacts) ---------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEXUM_S3_BUCKET=

# ---- CockroachDB MCP (inspection plane, read-only role) ----------------
COCKROACH_MCP_ENDPOINT=
